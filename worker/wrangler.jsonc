// Headronist MCP backend. No routes and no workers.dev URL: only headron.tech/mcp
// reaches it, through a service binding. Run `python3 worker/build.py` first.
{
  "name": "headronist-mcp",
  "main": "dist/entry.py",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["python_workers", "disable_python_external_sdk"],
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Data", "globs": ["**/*.json"], "fallthrough": true }]
}
