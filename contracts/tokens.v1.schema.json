{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Headronist Token Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "colors",
    "spacing",
    "radii",
    "type"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "colors": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9a-fA-F]{6}$"
      },
      "required": [
        "ground",
        "light",
        "band",
        "mark",
        "soft",
        "deep"
      ]
    },
    "spacing": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 256
      }
    },
    "radii": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 256
      }
    },
    "type": {
      "type": "object",
      "required": [
        "family",
        "basePx",
        "scale"
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "basePx": {
          "type": "number",
          "minimum": 10,
          "maximum": 30
        },
        "scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 2
        }
      }
    }
  }
}