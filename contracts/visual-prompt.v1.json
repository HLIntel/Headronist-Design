{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Headronist visual prompt brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "intent",
    "audience",
    "style",
    "palette",
    "aspectRatio",
    "exactText",
    "referenceContext",
    "constraints"
  ],
  "properties": {
    "version": {
      "const": "1"
    },
    "kind": {
      "enum": [
        "hero",
        "background",
        "illustration",
        "diagram",
        "logo",
        "social",
        "icon"
      ]
    },
    "intent": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1200
    },
    "audience": {
      "type": "string",
      "maxLength": 160
    },
    "style": {
      "type": "string",
      "maxLength": 200
    },
    "palette": {
      "type": "string",
      "maxLength": 80
    },
    "aspectRatio": {
      "enum": [
        "1:1",
        "4:5",
        "9:16",
        "16:9",
        "3:2",
        "21:9"
      ]
    },
    "exactText": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "referenceContext": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
